---
import Layout from '../layouts/Layout.astro';

const contacts = [
  {
    label: 'Email',
    value: 'iuryrosal@gmail.com',
    href: 'mailto:iuryrosal@gmail.com',
    description: 'Best for research collaborations and academic inquiries.',
  },
  {
    label: 'GitHub',
    value: 'iuryrosal',
    href: 'https://github.com/iuryrosal',
    description: 'Open-source contributions and code.',
  },
  {
    label: 'LinkedIn',
    value: 'iuryrosal',
    href: 'https://linkedin.com/in/iuryrosal',
    description: 'Professional network and career updates.',
  },
  {
    label: 'Instagram',
    value: '@iuryrosal',
    href: 'https://instagram.com/iuryrosal',
    description: 'Personal updates and day-to-day.',
  },
  {
    label: 'Lattes',
    value: 'CV Lattes',
    href: 'http://lattes.cnpq.br/',
    description: 'Brazilian academic curriculum vitae.',
  },
];
---

<Layout title="Contact" description="Get in touch with Iury Rosal.">
  <div class="max-w-3xl mx-auto px-6 py-16">
    <p class="section-subheading">Get in touch</p>
    <h1 class="text-3xl font-bold text-slate-100 mb-4">Contact</h1>
    <p class="text-slate-400 mb-10 leading-relaxed">
      I'm open to research collaborations, speaking invitations, and interesting conversations.
      Reach out through any of the channels below.
    </p>

    <div class="flex flex-col gap-4">
      {contacts.map(({ label, value, href, description }) => (
        <a
          href={href}
          target={href.startsWith('mailto') ? undefined : '_blank'}
          rel="noopener noreferrer"
          class="card flex flex-col sm:flex-row sm:items-center gap-3 group hover:border-blue-400/50"
        >
          <div class="sm:w-24 shrink-0">
            <span class="text-xs font-semibold text-blue-400 uppercase tracking-wider">{label}</span>
          </div>
          <div class="flex-1">
            <p class="text-slate-100 font-medium group-hover:text-blue-400 transition-colors">{value}</p>
            <p class="text-slate-500 text-sm">{description}</p>
          </div>
          <svg class="text-slate-600 group-hover:text-blue-400 transition-colors shrink-0 hidden sm:block" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
          </svg>
        </a>
      ))}
    </div>
  </div>
</Layout>
