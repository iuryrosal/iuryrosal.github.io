---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPublications = await getCollection('publications');
const allProjects = await getCollection('projects');

const featuredProjects = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const recentPublications = allPublications
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/iuryrosal' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/iuryrosal' },
  { label: 'Lattes', href: 'http://lattes.cnpq.br/' },
  { label: 'Instagram', href: 'https://instagram.com/iuryrosal' },
  { label: 'Email', href: 'mailto:iuryrosal@gmail.com' },
];

const typeColors: Record<string, string> = {
  journal: 'text-emerald-400 bg-emerald-400/10',
  conference: 'text-blue-400 bg-blue-400/10',
  workshop: 'text-amber-400 bg-amber-400/10',
  preprint: 'text-slate-400 bg-slate-400/10',
};
---

<Layout title="Home">
  <!-- Hero / About -->
  <section id="about" class="max-w-5xl mx-auto px-6 pt-20 pb-16">
    <div class="flex flex-col md:flex-row gap-10 items-start">
      <div class="shrink-0">
        <div class="w-32 h-32 rounded-full bg-slate-700 border-2 border-blue-400/30 overflow-hidden">
          <img
            src="/profile.jpg"
            alt="Iury Rosal"
            class="w-full h-full object-cover"
            onerror="this.style.display='none'"
          />
        </div>
      </div>
      <div class="flex-1">
        <p class="section-subheading">About</p>
        <h1 class="text-4xl font-bold text-slate-100 mb-4 leading-tight">Iury Rosal</h1>
        <p class="text-slate-300 text-lg leading-relaxed mb-6 max-w-2xl">
          Researcher, educator, and software engineer interested in data engineering, machine learning,
          and applied software systems. I build tools, teach, and investigate how software and data
          intersect in real-world settings.
        </p>
        <div class="flex flex-wrap gap-3">
          {socialLinks.map(({ label, href }) => (
            <a
              href={href}
              target={href.startsWith('mailto') ? undefined : '_blank'}
              rel="noopener noreferrer"
              class="text-sm px-4 py-1.5 rounded-full border border-slate-700 text-slate-300 hover:border-blue-400 hover:text-blue-400 transition-all duration-150"
            >
              {label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="max-w-5xl mx-auto px-6 py-12 border-t border-slate-800">
    <div class="flex items-center justify-between mb-6">
      <div>
        <p class="section-subheading">Selected Work</p>
        <h2 class="section-heading">Projects</h2>
      </div>
      <a href="/projects" class="link-accent text-sm hidden sm:block">View all →</a>
    </div>
    <div class="grid md:grid-cols-3 gap-4">
      {featuredProjects.map(project => (
        <div class="card flex flex-col gap-3">
          <div class="flex items-start justify-between gap-2">
            <h3 class="text-slate-100 font-semibold leading-snug">{project.data.title}</h3>
            <span class="text-slate-500 text-xs shrink-0">{project.data.year}</span>
          </div>
          <p class="text-slate-400 text-sm leading-relaxed flex-1">{project.data.description}</p>
          <div class="flex flex-wrap gap-1">
            {project.data.tech.slice(0, 4).map(t => <span class="tag">{t}</span>)}
          </div>
          <div class="flex gap-3 pt-1">
            {project.data.github && (
              <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="link-accent text-xs">GitHub ↗</a>
            )}
            {project.data.demo && (
              <a href={project.data.demo} target="_blank" rel="noopener noreferrer" class="link-accent text-xs">Demo ↗</a>
            )}
          </div>
        </div>
      ))}
    </div>
    <a href="/projects" class="link-accent text-sm mt-4 inline-block sm:hidden">View all projects →</a>
  </section>

  <!-- Recent Publications -->
  <section class="max-w-5xl mx-auto px-6 py-12 border-t border-slate-800">
    <div class="flex items-center justify-between mb-6">
      <div>
        <p class="section-subheading">Research</p>
        <h2 class="section-heading">Publications</h2>
      </div>
      <a href="/publications" class="link-accent text-sm hidden sm:block">View all →</a>
    </div>
    <div class="flex flex-col gap-4">
      {recentPublications.map(pub => (
        <div class="card flex flex-col sm:flex-row sm:items-start gap-4">
          <span class={`text-xs font-semibold px-2 py-0.5 rounded shrink-0 mt-0.5 ${typeColors[pub.data.type]}`}>
            {pub.data.type}
          </span>
          <div class="flex-1 min-w-0">
            <h3 class="text-slate-100 font-medium leading-snug mb-1">
              {pub.data.url
                ? <a href={pub.data.url} target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">{pub.data.title}</a>
                : pub.data.title}
            </h3>
            <p class="text-slate-400 text-sm">{pub.data.authors.join(', ')}</p>
            <p class="text-slate-500 text-sm mt-0.5">{pub.data.venue} · {pub.data.year}</p>
          </div>
          <div class="flex gap-3 shrink-0">
            {pub.data.pdf && <a href={pub.data.pdf} target="_blank" rel="noopener noreferrer" class="link-accent text-xs">PDF ↗</a>}
          </div>
        </div>
      ))}
    </div>
    <a href="/publications" class="link-accent text-sm mt-4 inline-block sm:hidden">View all publications →</a>
  </section>

  <!-- Quick links to other sections -->
  <section class="max-w-5xl mx-auto px-6 py-12 border-t border-slate-800">
    <div class="grid sm:grid-cols-3 gap-4">
      <a href="/experience" class="card group flex flex-col gap-2">
        <p class="section-subheading group-hover:text-blue-300 transition-colors">Career</p>
        <h2 class="text-slate-100 font-semibold">Experience & CV</h2>
        <p class="text-slate-400 text-sm">Professional background and downloadable résumé.</p>
      </a>
      <a href="/teaching" class="card group flex flex-col gap-2">
        <p class="section-subheading group-hover:text-blue-300 transition-colors">Courses</p>
        <h2 class="text-slate-100 font-semibold">Teaching</h2>
        <p class="text-slate-400 text-sm">Courses and workshops I have taught.</p>
      </a>
      <a href="/contact" class="card group flex flex-col gap-2">
        <p class="section-subheading group-hover:text-blue-300 transition-colors">Get in touch</p>
        <h2 class="text-slate-100 font-semibold">Contact</h2>
        <p class="text-slate-400 text-sm">Reach out for collaborations or questions.</p>
      </a>
    </div>
  </section>
</Layout>
