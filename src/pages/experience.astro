---
import Layout from '../layouts/Layout.astro';

const experience = [
  {
    role: 'Data Platform Engineer',
    company: 'PicPay',
    period: 'Apr 2025 – Present',
    description: 'Building and scaling data platform services for a leading Brazilian fintech. Migrated jobs from AWS EMR to Databricks Serverless (40% cost reduction), built a data quality monitoring service covering 1000+ tables with 4000+ rules, and developed Data Cataloging APIs integrating Databricks and AWS.',
    tech: ['Databricks', 'PySpark', 'Apache Airflow', 'MongoDB', 'AWS', 'Python', 'SQL', 'RAG'],
  },
  {
    role: 'Researcher',
    company: 'SAIL PUC-Rio',
    period: 'Jul 2024 – Present',
    description: 'Experimentation applied to continuous retraining of ML models in production environments. Published at SBSoft 2026: Tools Track.',
    tech: ['Python', 'MLOps', 'MLflow'],
  },
  {
    role: 'Professor of Data Science and Analytics',
    company: 'PUC-Rio (Postgraduate Program)',
    period: 'Jul 2026 – Present',
    description: 'Data Engineering instructor for the Specialist Program in Data Science and Analytics at CCEC – PUC-Rio, covering cloud data platforms and pipeline development with Databricks.',
    tech: ['Databricks', 'Apache Spark', 'Python'],
  },
  {
    role: 'Data Engineer Professor',
    company: 'Apoena Stack',
    period: 'Sep 2023 – Present',
    description: 'Built a production RAG system using the Gemini API with custom document ingestion, semantic embeddings, and retrieval optimization, achieving 80% reduction in content editing time. Developed technical content on Python, Spark, Databricks, GCP, dbt, and Airflow.',
    tech: ['Python', 'Apache Spark', 'Databricks', 'GCP', 'RAG'],
  },
  {
    role: 'Data Engineer',
    company: 'ALLOS (via Avenue Code)',
    period: 'Jan 2024 – Apr 2025',
    description: 'Built scalable pipelines ingesting 10M+ records/day from PostgreSQL, MongoDB, and APIs into a Databricks Lakehouse serving 20+ internal teams. Created AI agents in Databricks GenAI Space and automated table cataloging in the silver and gold tiers.',
    tech: ['Databricks', 'PySpark', 'Apache Airflow', 'dbt', 'PostgreSQL', 'MongoDB'],
  },
  {
    role: 'Data Engineer',
    company: 'GDM (via Avenue Code)',
    period: 'Apr 2023 – Dec 2023',
    description: 'Developed data solutions for a global leader in agricultural innovation. Implemented BigQuery data replication via Cloud Functions, built private APIs on Cloud Run, and created geospatial data products for crop management using Python and R.',
    tech: ['GCP', 'BigQuery', 'Cloud Run', 'Cloud Functions', 'Python', 'R'],
  },
  {
    role: 'Data Engineer',
    company: 'Sabesp (via Engineering)',
    period: 'Nov 2022 – Mar 2023',
    description: "Architected data transport from Oracle to GCP for Brazil's largest water utility, handling 10M+ invoices/month. Achieved 62% cost reduction and cut the project timeline by 3 months. Led a team of 12 engineers.",
    tech: ['GCP', 'BigTable', 'Cloud Run', 'Dataflow', 'Python', 'Oracle'],
  },
  {
    role: 'Data Engineer',
    company: 'Itaú Unibanco (via Accenture)',
    period: 'Jun 2021 – Nov 2022',
    description: 'Built data ingestion flows and event-driven architectures for the largest bank in Latin America. Resolved 86% of production incidents in 2 months and scaled CloudWatch monitoring by 456% (600+ alerts) using Terraform.',
    tech: ['AWS Lambda', 'AWS SQS', 'AWS EventBridge', 'Python', 'Terraform', 'SQL'],
  },
  {
    role: 'Data Engineer',
    company: 'Universidade Federal do Ceará',
    period: 'Aug 2020 – Jul 2022',
    description: 'Research and data engineering projects including analysis of Hadoop OSS contribution patterns, COVID-19 case monitoring in Fortaleza, and public transport optimization for the Fortaleza 2040 government initiative.',
    tech: ['Python', 'Pandas', 'Streamlit', 'Plotly', 'SQL', 'Docker'],
  },
  {
    role: 'Data Engineer',
    company: 'Alldesk',
    period: 'Dec 2020 – Jun 2021',
    description: 'Developed classification models, customer segmentation, and data visualization pipelines for a major regional telemarketing company. Built web scraping solutions and deployed predictive models via Docker and Heroku.',
    tech: ['Python', 'Scikit-learn', 'Streamlit', 'Docker', 'SQL', 'Selenium'],
  },
  {
    role: 'Data Engineer',
    company: 'FEJECE',
    period: 'Jul 2020 – Dec 2020',
    description: 'Supported the federation of junior companies in Ceará with data monitoring dashboards in Python and Power BI, and a Telegram bot on GCP for startup discovery by service category.',
    tech: ['Python', 'Power BI', 'GCP'],
  },
  {
    role: 'Software Engineer',
    company: 'GTi Engenharia Jr.',
    period: 'Nov 2018 – Jun 2020',
    description: 'Developed web systems with Ruby on Rails and relational data modeling. Managed 13 client projects (all with NPS promoter scores) and led the trainee onboarding program for 4 consecutive intakes.',
    tech: ['Ruby on Rails', 'SQL', 'Python'],
  },
];

const education = [
  {
    degree: 'M.Sc. in Informatics – Software Engineering for Data',
    institution: 'Pontifícia Universidade Católica do Rio de Janeiro (PUC-Rio)',
    period: 'Mar 2024 – Jul 2026',
    description: 'Research on continuous experimentation applied to ML model retraining in production. Published at SBSoft 2026: Tools Track.',
  },
  {
    degree: 'Postgraduate in Data Engineering with Databricks and Spark',
    institution: 'Engenharia de Dados Academy',
    period: 'Apr 2025 – Apr 2027',
  },
  {
    degree: "Bachelor's in Computer Engineering",
    institution: 'Universidade Federal do Ceará (UFC)',
    period: 'Jan 2018 – Dec 2022',
    description: 'Graduated Cum Laude.',
  },
];
---

<Layout title="Experience" description="Professional experience and CV of Iury Rosal.">
  <div class="max-w-5xl mx-auto px-6 py-16">
    <div class="flex items-start justify-between mb-10">
      <div>
        <p class="section-subheading">Career</p>
        <h1 class="text-3xl font-bold text-slate-100">Experience</h1>
      </div>
      <a
        href="/cv.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 text-sm px-4 py-2 rounded-lg bg-blue-500/10 text-blue-400 border border-blue-400/20 hover:bg-blue-500/20 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Download CV
      </a>
    </div>

    <!-- Work Experience -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold text-slate-100 mb-6">Work Experience</h2>
      <div class="flex flex-col gap-5">
        {experience.map(job => (
          <div class="card flex flex-col sm:flex-row gap-4">
            <div class="sm:w-40 shrink-0">
              <p class="text-slate-500 text-sm">{job.period}</p>
            </div>
            <div class="flex-1">
              <h3 class="text-slate-100 font-semibold">{job.role}</h3>
              <p class="text-blue-400 text-sm mb-2">{job.company}</p>
              <p class="text-slate-400 text-sm leading-relaxed mb-3">{job.description}</p>
              <div class="flex flex-wrap gap-1.5">
                {job.tech.map(t => <span class="tag">{t}</span>)}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section>
      <h2 class="text-xl font-semibold text-slate-100 mb-6">Education</h2>
      <div class="flex flex-col gap-5">
        {education.map(edu => (
          <div class="card flex flex-col sm:flex-row gap-4">
            <div class="sm:w-40 shrink-0">
              <p class="text-slate-500 text-sm">{edu.period}</p>
            </div>
            <div class="flex-1">
              <h3 class="text-slate-100 font-semibold">{edu.degree}</h3>
              <p class="text-blue-400 text-sm mb-2">{edu.institution}</p>
              {edu.description && <p class="text-slate-400 text-sm leading-relaxed">{edu.description}</p>}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
